rules_version = '2';

// Firebase Storage Security Rules for EduSync SIS
service firebase.storage {
  match /b/{bucket}/o {
    
    // Student photos - allow any authenticated user to upload
    // This is simplified to avoid Firestore lookups which can fail
    // Application-level permissions are enforced in the frontend
    match /students/{studentId}/profile.jpg {
      // Allow any authenticated user to read student photos
      allow read: if request.auth != null;
      
      // Allow any authenticated user to upload/update/delete photos
      // WITH file validation (5MB max, JPEG/PNG only)
      allow write: if request.auth != null && 
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|jpg|png)');
    }
    
    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
