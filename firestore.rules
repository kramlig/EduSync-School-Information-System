rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // DepEd Forms Collections - Added Oct 22, 2025
    // ========================================
    
    // Form 137 - Academic History / Permanent Record
    // Staff with appropriate roles can read/write
    match /academicHistory/{recordId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      // TODO: Add role-based validation when auth includes custom claims
      // allow write: if request.auth.token.role in ['admin', 'registrar', 'principal'];
    }
    
    // Form 138 - Report Cards
    // Teachers can write for their students, all staff can read
    match /reportCards/{cardId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      // TODO: Add role-based validation
      // allow write: if request.auth.token.role in ['admin', 'teacher', 'principal', 'registrar'];
    }
    
    // School Forms - SF1, SF2, SF9 (EBEIS)
    // Admin and registrar can manage
    match /schoolForms/{formId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      // TODO: Add role-based validation
      // allow write: if request.auth.token.role in ['admin', 'registrar', 'principal'];
    }
    
    // ELLN Assessments - K-3 Early Learning
    // Teachers and admin can manage
    match /ellnAssessments/{assessmentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      // TODO: Add role-based validation
      // allow write: if request.auth.token.role in ['admin', 'teacher', 'principal'];
    }
    
    // Form Generation Log - Analytics & Tracking
    // All authenticated users can read, only system can write
    match /formGenerationLog/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false; // Log entries are immutable
    }
    
    // ========================================
    // End DepEd Forms Collections
    // ========================================
    
    // ========================================
    // Enrollment System - Added Nov 1, 2025
    // ========================================
    
    // Enrollment Applications
    // Security model:
    // 1. Public can CREATE applications (no auth required for enrollment portal)
    // 2. Authenticated users can READ all applications (needed for admin dashboard)
    // 3. Only authenticated users can UPDATE/DELETE (admin actions)
    match /enrollmentApplications/{applicationId} {
      // ✅ Allow public creation - Parents don't need account to apply
      allow create: if true 
        && request.resource.data.keys().hasAll(['applicationNumber', 'studentInfo', 'guardian1', 'currentAddress', 'academicInfo', 'status', 'submittedAt'])
        && request.resource.data.status == 'submitted';
      
      // ✅ Allow authenticated users to read (admins need to see all applications)
      allow read: if request.auth != null;
      
      // ✅ Allow authenticated users to update (admin approve/reject actions)
      // Validate that only specific fields can be updated
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNotes', 'rejectionReason', 'enrolledStudentId', 'updatedAt']);
      
      // ✅ Only authenticated users can delete (rare admin action)
      allow delete: if request.auth != null;
      
      // TODO: Add role-based validation when custom claims are implemented
      // allow update: if request.auth != null && request.auth.token.role == 'admin';
      // allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Settings Collection
    // - Public read access (enrollment portal needs to check if enrollment is enabled)
    // - Only authenticated users can write (admin configuration)
    match /settings/{settingId} {
      // ✅ Allow public read - Enrollment portal needs to check enrollmentConfig
      allow read: if true;
      
      // ✅ Only authenticated users can update settings
      allow write: if request.auth != null;
      
      // TODO: Add admin-only restriction when custom claims are implemented
      // allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // ========================================
    // End Enrollment System
    // ========================================
    
    // Allow public read access for all collections to enable initial data load.
    // WARNING: This is permissive. Data should be secured further post-login.
    // For now, this unblocks the login screen.
    match /{document=**} {
      allow read: if true;
      // TEMP: Allow all writes during local emulator debugging to resolve 403 issues.
      // IMPORTANT: Revert to `allow write: if request.auth != null;` before deploying to prod.
      allow write: if request.auth != null;
    }
  }
}
