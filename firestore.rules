rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================
    // ⚠️ TRANSITION MODE ACTIVE
    // ========================================
    // Users without custom claims (role) are granted legacy access.
    // This is TEMPORARY to allow smooth migration.
    // 
    // TODO: After all users have roles assigned:
    // 1. Remove isLegacyUser() checks from all rules
    // 2. Test with roles only
    // 3. Deploy strict rules
    // ========================================
    
    // ========================================
    // HELPER FUNCTIONS - Role-Based Access Control
    // ========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      // FIXED: Check if 'role' key exists before accessing it
      return isAuthenticated() && 
             request.auth.token.keys().hasAny(['role']) && 
             request.auth.token.role != null 
        ? request.auth.token.role 
        : 'none';
    }
    
    function hasRole() {
      // FIXED: Check if 'role' key exists before accessing it
      return isAuthenticated() && 
             request.auth.token.keys().hasAny(['role']) && 
             request.auth.token.role != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }
    
    function isPrincipal() {
      return isAuthenticated() && getUserRole() == 'principal';
    }
    
    function isRegistrar() {
      return isAuthenticated() && getUserRole() == 'registrar';
    }
    
    function isTeacher() {
      return isAuthenticated() && getUserRole() == 'teacher';
    }
    
    function isParent() {
      return isAuthenticated() && getUserRole() == 'parent';
    }
    
    function isSuperAdmin() {
      // Super admins can access all schools (for management/support)
      // Check for role-based superadmin (primary) or legacy custom claim
      return isAuthenticated() && (
        getUserRole() == 'superadmin' ||
        (request.auth.token.keys().hasAny(['isSuperAdmin']) && request.auth.token.isSuperAdmin == true)
      );
    }
    
    // TEMPORARY: Allow access for users without roles (during transition)
    // TODO: Remove this after all users have roles assigned
    function isLegacyUser() {
      return isAuthenticated() && !hasRole();
    }
    
    function isStaff() {
      return isAdmin() || isPrincipal() || isRegistrar() || isTeacher();
    }
    
    function isAdminOrPrincipal() {
      return isAdmin() || isPrincipal();
    }
    
    function isAdminOrRegistrar() {
      return isAdmin() || isRegistrar();
    }
    
    // ========================================
    // MULTI-TENANT HELPER FUNCTIONS
    // ========================================
    
    function getUserSchoolId() {
      // Get the primary schoolId from user's custom claims
      return isAuthenticated() && 
             request.auth.token.keys().hasAny(['schoolId']) && 
             request.auth.token.schoolId != null 
        ? request.auth.token.schoolId 
        : 'default';
    }
    
    function getUserSchoolIds() {
      // Get all schoolIds for multi-school users (e.g., teachers at multiple schools)
      return isAuthenticated() && 
             request.auth.token.keys().hasAny(['schoolIds']) && 
             request.auth.token.schoolIds != null 
        ? request.auth.token.schoolIds 
        : [getUserSchoolId()];
    }
    
    function belongsToUserSchool(resourceSchoolId) {
      // Check if a document's schoolId matches any of the user's schools
      return resourceSchoolId in getUserSchoolIds();
    }
    
    function isCreatingForUserSchool() {
      // Verify create operations use the user's primary schoolId
      // Super admins can create for any school
      return isSuperAdmin() || request.resource.data.schoolId == getUserSchoolId();
    }
    
    function hasValidSchoolId(docData) {
      // Verify the incoming data has valid schoolId (for CREATE operations)
      return docData.keys().hasAny(['schoolId']) &&
             docData.schoolId is string &&
             docData.schoolId.size() > 0 &&
             belongsToUserSchool(docData.schoolId);
    }
    
    function schoolIdUnchanged() {
      // Verify schoolId is not being changed (for UPDATE operations)
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['schoolId']);
    }
    
    function schoolExists(schoolId) {
      // Verify the schoolId exists in schools collection (prevents orphaned documents)
      return isSuperAdmin() || exists(/databases/$(database)/documents/schools/$(schoolId));
    }
    
    // ========================================
    // CORE COLLECTIONS - Students, Teachers, Sections
    // ========================================
    
    // Students Collection
    match /students/{studentId} {
      // Staff can read students from their school(s)
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can only read their own children (same school check implicit via parentIds)
      allow read: if isParent() && request.auth.uid in resource.data.parentIds;
      
      // Admin and registrar can create students for their school
      // STRICT: Must have valid schoolId and it must exist
      allow create: if (isAdminOrRegistrar() && hasValidSchoolId(request.resource.data) && schoolExists(request.resource.data.schoolId)) 
                    || isSuperAdmin() 
                    || isLegacyUser();
      
      // Admin and registrar can update students in their school
      // STRICT: Cannot change schoolId
      allow update: if (isAdminOrRegistrar() && belongsToUserSchool(resource.data.schoolId) && schoolIdUnchanged()) 
                    || isSuperAdmin() 
                    || isLegacyUser();
      
      // Only admin can delete students (in their school)
      allow delete: if (isAdmin() && belongsToUserSchool(resource.data.schoolId)) 
                    || isSuperAdmin() 
                    || isLegacyUser();
    }
    
    // Teachers Collection
    match /teachers/{teacherId} {
      // All authenticated users can read teachers for login lookup
      // Multi-tenant: Teachers can work at multiple schools (schoolIds array)
      allow read: if isAuthenticated() || isLegacyUser();
      
      // Admin and principal can manage teachers in their school
      // STRICT: Must have valid schoolId on create, cannot change on update
      allow create: if (isAdminOrPrincipal() && hasValidSchoolId(request.resource.data) && schoolExists(request.resource.data.schoolId))
                    || isSuperAdmin()
                    || isLegacyUser();
      
      allow update: if (isAdminOrPrincipal() && belongsToUserSchool(resource.data.schoolId) && schoolIdUnchanged()) 
                    || isSuperAdmin() 
                    || isLegacyUser();
      
      allow delete: if (isAdminOrPrincipal() && belongsToUserSchool(resource.data.schoolId))
                    || isSuperAdmin()
                    || isLegacyUser();
    }
    
    // Sections Collection
    match /sections/{sectionId} {
      // Staff can read sections from their school(s)
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can read sections their children are enrolled in (implicit school check)
      allow read: if isParent() && request.auth.uid in resource.data.parentIds;
      
      // Admin, principal, and registrar can manage sections in their school
      // STRICT: Must have valid schoolId on create, cannot change on update
      allow create: if ((isAdmin() || isPrincipal() || isRegistrar()) && hasValidSchoolId(request.resource.data) && schoolExists(request.resource.data.schoolId))
                    || isSuperAdmin() 
                    || isLegacyUser();
      
      allow update: if (isAdminOrPrincipal() && belongsToUserSchool(resource.data.schoolId) && schoolIdUnchanged())
                    || isSuperAdmin() 
                    || isLegacyUser();
      
      allow delete: if (isAdmin() && belongsToUserSchool(resource.data.schoolId))
                    || isSuperAdmin()
                    || isLegacyUser();
    }
    
    // Parents Collection
    match /parents/{parentId} {
      // Staff can read parents from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can only read their own profile
      allow read: if isParent() && request.auth.uid == parentId;
      
      // Parents can update their own profile (notification preferences, contact info)
      // STRICT: Parents cannot change their schoolId
      allow update: if ((isParent() && request.auth.uid == parentId && schoolIdUnchanged()) 
                        || (isAdminOrRegistrar() && belongsToUserSchool(resource.data.schoolId) && schoolIdUnchanged()))
                    || isSuperAdmin()
                    || isLegacyUser();
      
      // Admin and registrar can create/delete parents in their school
      // STRICT: Must have valid schoolId on create
      allow create: if (isAdminOrRegistrar() && hasValidSchoolId(request.resource.data) && schoolExists(request.resource.data.schoolId)) 
                    || isSuperAdmin() 
                    || isLegacyUser();
      allow delete: if (isAdmin() && belongsToUserSchool(resource.data.schoolId)) 
                    || isSuperAdmin() 
                    || isLegacyUser();
    }
    
    // ========================================
    // ACADEMIC COLLECTIONS - Grades, Attendance, Assignments
    // ========================================
    
    // Grades Collection
    match /grades/{gradeId} {
      // Staff can read grades from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can read their children's grades (implicit school check)
      allow read: if isParent() && request.auth.uid == resource.data.parentId;
      
      // Teachers and admin can create/update grades in their school
      allow create, update: if ((isTeacher() || isAdmin()) && isCreatingForUserSchool()) 
                            || ((isTeacher() || isAdmin()) && belongsToUserSchool(resource.data.schoolId))
                            || isSuperAdmin() 
                            || isLegacyUser();
      
      // Only admin can delete grades in their school
      allow delete: if (isAdmin() && belongsToUserSchool(resource.data.schoolId)) 
                    || isSuperAdmin() 
                    || isLegacyUser();
    }
    
    // Attendance Records
    match /attendanceRecords/{recordId} {
      // Staff can read attendance from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can read their children's attendance (implicit school check)
      allow read: if isParent() && request.auth.uid == resource.data.parentId;
      
      // Teachers and admin can manage attendance in their school
      allow write: if ((isTeacher() || isAdmin()) && belongsToUserSchool(resource.data.schoolId)) 
                   || ((isTeacher() || isAdmin()) && isCreatingForUserSchool())
                   || isSuperAdmin() 
                   || isLegacyUser();
    }
    
    // Assignments Collection
    match /assignments/{assignmentId} {
      // Staff can read assignments from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin()
                  || isLegacyUser();
      
      // Teachers and admin can manage assignments in their school
      allow write: if ((isTeacher() || isAdmin()) && isCreatingForUserSchool()) 
                   || ((isTeacher() || isAdmin()) && belongsToUserSchool(resource.data.schoolId))
                   || isSuperAdmin() 
                   || isLegacyUser();
    }
    
    // Learning Areas / Subjects
    match /learningAreas/{areaId} {
      // Staff can read learning areas from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin()
                  || isLegacyUser();
      
      // Admin and principal can manage learning areas in their school
      allow write: if (isAdminOrPrincipal() && isCreatingForUserSchool()) 
                   || (isAdminOrPrincipal() && belongsToUserSchool(resource.data.schoolId))
                   || isSuperAdmin() 
                   || isLegacyUser();
    }
    
    // Class Schedules
    match /schedules/{scheduleId} {
      // Staff can read schedules from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin();
      
      // Admin, principal, and registrar can manage schedules in their school
      allow write: if ((isAdmin() || isPrincipal() || isRegistrar()) && isCreatingForUserSchool()) 
                   || ((isAdmin() || isPrincipal() || isRegistrar()) && belongsToUserSchool(resource.data.schoolId))
                   || isSuperAdmin() 
                   || isLegacyUser();
    }
    
    // Core Values Assessment
    match /coreValues/{valueId} {
      // Staff can read assessments from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can read their children's assessments (implicit school check)
      allow read: if isParent() && request.auth.uid == resource.data.parentId;
      
      // Teachers and admin can write assessments in their school
      allow write: if ((isTeacher() || isAdmin()) && isCreatingForUserSchool()) 
                   || ((isTeacher() || isAdmin()) && belongsToUserSchool(resource.data.schoolId))
                   || isSuperAdmin() 
                   || isLegacyUser();
    }
    
    // ========================================
    // DepEd Forms Collections
    // ========================================
    
    // Form 137 - Academic History / Permanent Record
    match /academicHistory/{recordId} {
      // Staff can read records from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can read their children's records (implicit school check)
      allow read: if isParent() && request.auth.uid == resource.data.parentId;
      
      // Admin, registrar, and principal can manage Form 137 in their school
      allow write: if ((isAdmin() || isRegistrar() || isPrincipal()) && isCreatingForUserSchool()) 
                   || ((isAdmin() || isRegistrar() || isPrincipal()) && belongsToUserSchool(resource.data.schoolId))
                   || isSuperAdmin() 
                   || isLegacyUser();
    }
    
    // Form 138 - Report Cards
    match /reportCards/{cardId} {
      // Staff can read report cards from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can read their children's report cards (implicit school check)
      allow read: if isParent() && request.auth.uid == resource.data.parentId;
      
      // Teachers, admin, and registrar can manage report cards in their school
      allow write: if ((isTeacher() || isAdmin() || isRegistrar()) && isCreatingForUserSchool()) 
                   || ((isTeacher() || isAdmin() || isRegistrar()) && belongsToUserSchool(resource.data.schoolId))
                   || isSuperAdmin() 
                   || isLegacyUser();
    }
    
    // School Forms - SF1, SF2, SF9 (EBEIS)
    match /schoolForms/{formId} {
      // Staff can read school forms from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Admin, registrar, and principal can manage school forms in their school
      allow write: if ((isAdmin() || isRegistrar() || isPrincipal()) && isCreatingForUserSchool()) 
                   || ((isAdmin() || isRegistrar() || isPrincipal()) && belongsToUserSchool(resource.data.schoolId))
                   || isSuperAdmin() 
                   || isLegacyUser();
    }
    
    // ELLN Assessments - K-3 Early Learning
    match /ellnAssessments/{assessmentId} {
      // Staff can read assessments from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can read their children's assessments (implicit school check)
      allow read: if isParent() && request.auth.uid == resource.data.parentId;
      
      // Teachers and admin can manage assessments in their school
      allow write: if ((isTeacher() || isAdmin()) && isCreatingForUserSchool()) 
                   || ((isTeacher() || isAdmin()) && belongsToUserSchool(resource.data.schoolId))
                   || isSuperAdmin() 
                   || isLegacyUser();
    }
    
    // Form Generation Log - Analytics & Tracking
    match /formGenerationLog/{logId} {
      // Staff can read logs from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // All authenticated users can create logs for their school
      allow create: if (isAuthenticated() && isCreatingForUserSchool()) 
                    || isSuperAdmin() 
                    || isLegacyUser();
      
      // Logs are immutable
      allow update, delete: if false;
    }
    
    // ========================================
    // FINANCIAL COLLECTIONS - Billing & Payments
    // ========================================
    
    // Fee Structures
    match /feeStructures/{feeId} {
      // Staff can read fee structures from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can read fee structures from their school (implicit via child's school)
      // Note: Parent schoolId inherited from student during registration
      allow read: if isParent() || isLegacyUser();
      
      // Admin and registrar can manage fee structures in their school
      allow write: if (isAdminOrRegistrar() && isCreatingForUserSchool()) 
                   || (isAdminOrRegistrar() && belongsToUserSchool(resource.data.schoolId))
                   || isSuperAdmin() 
                   || isLegacyUser();
    }
    
    // Payment Records
    match /payments/{paymentId} {
      // Staff can read payments from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can read their own payments (implicit school check)
      allow read: if isParent() && request.auth.uid == resource.data.parentId;
      
      // Admin and registrar can create payments in their school
      allow create: if (isAdminOrRegistrar() && isCreatingForUserSchool()) 
                    || isSuperAdmin() 
                    || isLegacyUser();
      
      // Only admin can update/delete payments in their school
      allow update, delete: if (isAdmin() && belongsToUserSchool(resource.data.schoolId)) 
                            || isSuperAdmin() 
                            || isLegacyUser();
    }
    
    // Billing Ledgers
    match /billingLedgers/{ledgerId} {
      // Staff can read ledgers from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can read their own ledgers (implicit school check)
      allow read: if isParent() && request.auth.uid == resource.data.parentId;
      
      // Admin and registrar can write ledgers in their school
      allow write: if (isAdminOrRegistrar() && isCreatingForUserSchool()) 
                   || (isAdminOrRegistrar() && belongsToUserSchool(resource.data.schoolId))
                   || isSuperAdmin() 
                   || isLegacyUser();
    }
    
    // Billing Statements
    match /billingStatements/{statementId} {
      // Staff can read statements from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can read their own statements (implicit school check)
      allow read: if isParent() && request.auth.uid == resource.data.parentId;
      
      // Admin and registrar can manage statements in their school
      allow write: if (isAdminOrRegistrar() && isCreatingForUserSchool()) 
                   || (isAdminOrRegistrar() && belongsToUserSchool(resource.data.schoolId))
                   || isSuperAdmin() 
                   || isLegacyUser();
    }
    
    // Receipts
    match /receipts/{receiptId} {
      // Staff can read receipts from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can read their own receipts (implicit school check)
      allow read: if isParent() && request.auth.uid == resource.data.parentId;
      
      // Admin and registrar can create receipts in their school
      allow create: if (isAdminOrRegistrar() && isCreatingForUserSchool()) 
                    || isSuperAdmin() 
                    || isLegacyUser();
      
      // Only admin can update/delete receipts in their school
      allow update, delete: if (isAdmin() && belongsToUserSchool(resource.data.schoolId)) 
                            || isSuperAdmin() 
                            || isLegacyUser();
    }
    
    // Payment Proofs (uploaded by parents)
    match /paymentProofs/{proofId} {
      // Staff can read proofs from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can read their own proofs (implicit school check)
      allow read: if isParent() && request.auth.uid == resource.data.parentId;
      
      // Parents can upload their own proofs (inherit schoolId from parent profile)
      allow create: if (isParent() && request.auth.uid == request.resource.data.parentId && isCreatingForUserSchool())
                    || isSuperAdmin();
      
      // Admin and registrar can update proofs in their school (verify/reject)
      allow update: if (isAdminOrRegistrar() && belongsToUserSchool(resource.data.schoolId)) 
                    || isSuperAdmin() 
                    || isLegacyUser();
      
      // Only admin can delete proofs in their school
      allow delete: if (isAdmin() && belongsToUserSchool(resource.data.schoolId)) 
                    || isSuperAdmin() 
                    || isLegacyUser();
    }
    
    // ========================================
    // ENROLLMENT SYSTEM
    // ========================================
    
    // Enrollment Applications
    match /enrollmentApplications/{applicationId} {
      // Public can CREATE applications (no auth required for enrollment portal)
      // Application inherits schoolId from verified student or uses 'default'
      allow create: if request.resource.data.keys().hasAll(['applicationNumber', 'studentInfo', 'guardian1', 'currentAddress', 'academicInfo', 'status', 'submittedAt', 'schoolId'])
        && request.resource.data.status == 'submitted';
      
      // Public can READ their own application by applicationNumber (for status checking)
      allow read: if true;
      
      // Staff can read applications from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Admin, registrar, and principal can update applications in their school (approve/reject)
      allow update: if ((isAdmin() || isRegistrar() || isPrincipal()) && belongsToUserSchool(resource.data.schoolId) || isLegacyUser())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt', 'reviewNotes', 'rejectionReason', 'enrolledStudentId', 'updatedAt']);
      
      // Only admin can delete applications in their school
      allow delete: if (isAdmin() && belongsToUserSchool(resource.data.schoolId)) 
                    || isSuperAdmin() 
                    || isLegacyUser();
    }
    
    // ========================================
    // NOTIFICATION SYSTEM
    // ========================================
    
    // Notifications Collection
    match /notifications/{notificationId} {
      // Staff can read notifications from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can read their own notifications (implicit school check)
      allow read: if isParent() && request.auth.uid == resource.data.recipientId;
      
      // System can create notifications (via Cloud Functions)
      allow create: if (isAuthenticated() && isCreatingForUserSchool()) 
                    || isSuperAdmin() 
                    || isLegacyUser();
      
      // Only admin can update/delete notifications in their school
      allow update, delete: if (isAdmin() && belongsToUserSchool(resource.data.schoolId)) 
                            || isSuperAdmin() 
                            || isLegacyUser();
    }
    
    // Mail Queue (for Firebase Email Extension)
    match /mail/{mailId} {
      // Only system (Cloud Functions) can access
      allow read, write: if false;
    }
    
    // Notification Errors (for debugging)
    match /notificationErrors/{errorId} {
      // Only admin can read errors from their school
      allow list: if isAdmin() || isSuperAdmin() || isLegacyUser();
      
      allow get: if (isAdmin() && belongsToUserSchool(resource.data.schoolId)) 
                 || isSuperAdmin() 
                 || isLegacyUser();
      
      // System can create errors (with schoolId)
      allow create: if (isAuthenticated() && isCreatingForUserSchool()) 
                    || isSuperAdmin() 
                    || isLegacyUser();
      
      // Errors are immutable
      allow update, delete: if false;
    }
    
    // ========================================
    // ANNOUNCEMENTS & COMMUNICATION
    // ========================================
    
    // Announcements Collection
    match /announcements/{announcementId} {
      // Staff can list announcements (query filters by schoolId in application code)
      // Staff can get individual announcements from their school
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();
      
      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId)) 
                 || isSuperAdmin()
                 || isLegacyUser();
      
      // Staff can create announcements for their school
      allow create: if (isStaff() && isCreatingForUserSchool()) 
                    || isSuperAdmin() 
                    || isLegacyUser();
      
      // Admin and principal can update/delete announcements in their school
      allow update, delete: if (isAdminOrPrincipal() && belongsToUserSchool(resource.data.schoolId)) 
                            || isSuperAdmin() 
                            || isLegacyUser();
    }
    
    // Lesson Plans
    match /lessonPlans/{planId} {
      // Teachers can read lesson plans from their school(s)
      allow list: if (isTeacher() || isAdmin() || isPrincipal()) || isSuperAdmin() || isLegacyUser();
      
      allow get: if ((isTeacher() || isAdmin() || isPrincipal()) && belongsToUserSchool(resource.data.schoolId)) 
                 || isSuperAdmin() 
                 || isLegacyUser();
      
      // Teachers can create lesson plans for their school
      allow create: if (isTeacher() && isCreatingForUserSchool()) 
                    || isSuperAdmin() 
                    || isLegacyUser();
      
      // Teachers can manage their own lesson plans (in their school)
      allow update, delete: if ((isTeacher() && resource.data.teacherId == request.auth.uid && belongsToUserSchool(resource.data.schoolId)) || isLegacyUser());
      
      // Admin can manage all lesson plans in their school
      allow write: if (isAdmin() && belongsToUserSchool(resource.data.schoolId)) 
                   || isSuperAdmin() 
                   || isLegacyUser();
    }
    
    // ========================================
    // SETTINGS & CONFIGURATION
    // ========================================
    
    // Settings Collection
    match /settings/{settingId} {
      // Public read access (enrollment portal needs to check settings by schoolId)
      // Note: settingId is typically the schoolId (e.g., 'default', 'school-001')
      allow read: if true;
      
      // Super admin can manage all settings
      allow write: if isSuperAdmin();
      
      // Admin can update settings for their school only
      allow write: if (isAdmin() && settingId == getUserSchoolId()) 
                   || isLegacyUser();
    }
    
    // School Configuration
    match /schoolConfig/{configId} {
      // Staff can read config from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin();
      
      // Only admin can update config for their school
      allow write: if (isAdmin() && isCreatingForUserSchool()) 
                   || (isAdmin() && belongsToUserSchool(resource.data.schoolId))
                   || isSuperAdmin() 
                   || isLegacyUser();
    }
    
    // User Roles (for role management)
    match /userRoles/{userId} {
      // Users can read their own role
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Admin can read all roles from their school
      // Note: Admin cannot see roles from other schools
      allow read: if isAdmin() || isLegacyUser();
      
      // Only admin can manage roles for users in their school
      allow write: if isAdmin() || isSuperAdmin() || isLegacyUser();
    }
    
    // ========================================
    // MULTI-TENANT: SCHOOLS COLLECTION
    // ========================================
    
    // Schools Collection (metadata for each school)
    match /schools/{schoolId} {
      // All authenticated users can read school metadata
      // This allows SchoolSwitcher to display school names
      allow read: if isAuthenticated();
      
      // Only super admin can create/update/delete schools
      allow write: if isSuperAdmin();
    }
    
    // ========================================
    // SUBSTITUTE TEACHER SYSTEM
    // ========================================
    
    // Substitute Assignments
    match /substituteAssignments/{assignmentId} {
      // Staff can read substitute assignments from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Admin and principal can manage substitutes in their school
      allow write: if (isAdminOrPrincipal() && isCreatingForUserSchool()) 
                   || (isAdminOrPrincipal() && belongsToUserSchool(resource.data.schoolId))
                   || isSuperAdmin() 
                   || isLegacyUser();
    }
    
    // ========================================
    // ADDITIONAL ACADEMIC COLLECTIONS
    // ========================================
    
    // Student Assignment Grades (grades for specific assignments)
    match /studentAssignmentGrades/{gradeId} {
      // Staff can read assignment grades from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can read their children's assignment grades (implicit school check)
      allow read: if isParent() && request.auth.uid == resource.data.parentId;
      
      // Teachers and admin can write assignment grades in their school
      allow create, update: if ((isTeacher() || isAdmin()) && isCreatingForUserSchool()) 
                            || ((isTeacher() || isAdmin()) && belongsToUserSchool(resource.data.schoolId))
                            || isSuperAdmin() 
                            || isLegacyUser();
      
      // Only admin can delete in their school
      allow delete: if (isAdmin() && belongsToUserSchool(resource.data.schoolId)) 
                    || isSuperAdmin() 
                    || isLegacyUser();
    }
    
    // Core Value Grades (character development grades)
    match /coreValueGrades/{gradeId} {
      // Staff can read core value grades from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can read their children's core value grades (implicit school check)
      allow read: if isParent() && request.auth.uid == resource.data.parentId;
      
      // Teachers and admin can write core value grades in their school
      allow create, update: if ((isTeacher() || isAdmin()) && isCreatingForUserSchool()) 
                            || ((isTeacher() || isAdmin()) && belongsToUserSchool(resource.data.schoolId))
                            || isSuperAdmin() 
                            || isLegacyUser();
      
      // Only admin can delete in their school
      allow delete: if (isAdmin() && belongsToUserSchool(resource.data.schoolId)) 
                    || isSuperAdmin() 
                    || isLegacyUser();
    }
    
    // Class Schedules (alternative name for schedules)
    match /classSchedules/{scheduleId} {
      // Staff can read schedules from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin()
                  || isLegacyUser();
      
      // Admin, principal, and registrar can manage schedules in their school
      allow write: if ((isAdmin() || isPrincipal() || isRegistrar()) && isCreatingForUserSchool()) 
                   || ((isAdmin() || isPrincipal() || isRegistrar()) && belongsToUserSchool(resource.data.schoolId))
                   || isSuperAdmin() 
                   || isLegacyUser();
    }
    
    // School Years Configuration
    match /schoolYears/{yearId} {
      // Staff can read school years from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin();
      
      // Only admin can manage school years for their school
      allow write: if (isAdmin() && isCreatingForUserSchool()) 
                   || (isAdmin() && belongsToUserSchool(resource.data.schoolId))
                   || isSuperAdmin() 
                   || isLegacyUser();
    }
    
    // User Profiles (additional user data)
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Admin can read all profiles
      allow read: if isAdmin() || isLegacyUser();
      
      // Users can update their own profile
      allow update: if isAuthenticated() && request.auth.uid == userId;
      
      // Only admin can create/delete profiles
      allow create, delete: if isAdmin() || isLegacyUser();
    }
    
    // Teacher Validation Results
    match /validationResults/{resultId} {
      // Staff can read validation results from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Teachers can create validation results for their school
      allow create: if (isTeacher() && isCreatingForUserSchool()) 
                    || isSuperAdmin() 
                    || isLegacyUser();
      
      // Only admin can update/delete validation results in their school
      allow update, delete: if (isAdmin() && belongsToUserSchool(resource.data.schoolId)) 
                            || isSuperAdmin() 
                            || isLegacyUser();
    }
    
    // User Roles Audit Trail (Auto-Onboarding System)
    match /userRoles/{userId} {
      // Users can read their own role history
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Admins can read all role histories from their school
      allow read: if isAdmin() || isSuperAdmin() || isLegacyUser();
      
      // Super admin can write (for creating admins), Cloud Functions can also write
      allow write: if isSuperAdmin();
    }
    
    // ========================================
    // FINANCIAL: STUDENT LEDGERS
    // ========================================
    
    // Student Ledgers (detailed billing records per student per school year)
    match /studentLedgers/{ledgerId} {
      // Staff can read ledgers from their school
      // Staff can list (query) and get (read individual docs)
      allow list: if isStaff() || isSuperAdmin() || isLegacyUser();

      allow get: if (isStaff() && belongsToUserSchool(resource.data.schoolId))
                  || isSuperAdmin() 
                  || isLegacyUser();
      
      // Parents can read their children's ledgers (implicit school check)
      allow read: if isParent() && request.auth.uid == resource.data.parentId;
      
      // Admin and registrar can create/update ledgers in their school
      allow create: if (isAdminOrRegistrar() && isCreatingForUserSchool()) 
                    || isSuperAdmin() 
                    || isLegacyUser();
      
      allow update: if (isAdminOrRegistrar() && belongsToUserSchool(resource.data.schoolId)) 
                    || isSuperAdmin() 
                    || isLegacyUser();
      
      // Only admin can delete ledgers in their school
      allow delete: if (isAdmin() && belongsToUserSchool(resource.data.schoolId)) 
                    || isSuperAdmin() 
                    || isLegacyUser();
    }
    
    // ========================================
    // FALLBACK RULE - DENY ALL UNMATCHED
    // ========================================
    
    // IMPORTANT: This denies access to any collection not explicitly defined above
    // This is a security best practice - whitelist approach
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
