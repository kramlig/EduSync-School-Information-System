rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(roles) {
      return isSignedIn() && getUserDoc().data.role in roles;
    }

    // Users: users can read their own profile; admins can read all
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || hasRole(['admin']));
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Schools: readable by members of the school; writable by admins
    match /schools/{schoolId} {
      allow read: if isSignedIn() && getUserDoc().data.schoolId == schoolId;
      allow write: if hasRole(['admin']);
    }

    // Lessons: teachers and admins can create; school members can read
    match /schools/{schoolId}/lessons/{lessonId} {
      allow create: if isSignedIn() && (hasRole(['teacher','admin'])) && getUserDoc().data.schoolId == schoolId;
      allow read: if isSignedIn() && getUserDoc().data.schoolId == schoolId;
      allow update, delete: if hasRole(['admin']) || (hasRole(['teacher']) && resource.data.creatorId == request.auth.uid);
    }

    // General collections under a school: restrict to school members and roles
    match /schools/{schoolId}/{collection}/{docId} {
      allow read: if isSignedIn() && getUserDoc().data.schoolId == schoolId;
      allow create: if isSignedIn() && (hasRole(['teacher','admin'])) && getUserDoc().data.schoolId == schoolId;
      allow update, delete: if hasRole(['admin']) || (hasRole(['teacher']) && resource.data.creatorId == request.auth.uid);
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
