{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/generateLessonPlan",
        "function": "generateLessonPlan"
      },
      {
        "source": "/api/generateStudentReport",
        "function": "generateStudentReport"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
  ,
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8085
    }
  }
  ,
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
