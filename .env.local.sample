# Copy this file to `.env.local` and fill in your Firebase Web config.

# Production (live) Firebase config
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=edusync-sis
VITE_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# Use Firestore emulator locally? Set to true to point localhost at your emulator
VITE_USE_FIREBASE_EMULATOR=false

# If using emulator, set host/port. Our Firestore emulator runs on 127.0.0.1:8085
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=8085

# Optional: Auth emulator (not required for debug auth path)
VITE_USE_AUTH_EMULATOR=false
VITE_AUTH_EMULATOR_HOST=127.0.0.1
VITE_AUTH_EMULATOR_PORT=9099

# Gemini API key for AI-powered features (lesson plan generation, student reports)
# Get your API key from https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=
