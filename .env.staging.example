# Environment Variables for Staging
# Copy this to .env.staging when ready

# Firebase Configuration - STAGING PROJECT
VITE_FIREBASE_API_KEY=YOUR_STAGING_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=edusync-sis-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=edusync-sis-staging
VITE_FIREBASE_STORAGE_BUCKET=edusync-sis-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_STAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_STAGING_APP_ID

# Emulator Settings (disabled for staging)
VITE_FIRESTORE_EMULATOR_HOST=
VITE_FIRESTORE_EMULATOR_PORT=
VITE_USE_FIREBASE_EMULATOR=false
VITE_AUTH_EMULATOR_HOST=
VITE_AUTH_EMULATOR_PORT=
VITE_USE_AUTH_EMULATOR=false

# Gemini API (optional for staging)
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Environment
NODE_ENV=staging
